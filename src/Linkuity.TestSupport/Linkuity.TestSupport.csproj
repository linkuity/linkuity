<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>

    <!--
      A shared helper library, NOT a test project. Stated explicitly because it is easy to
      make it one by accident: adding an xunit reference here was enough for `dotnet test` on
      the solution to try to execute this assembly as a test host, which failed to resolve its
      dependencies and aborted the run. Anything requiring xunit or Testcontainers belongs in
      the test assembly that uses it.
    -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- For PostgresDatabaseFactory. No test-framework or container packages: see above. -->
    <PackageReference Include="Npgsql" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!--
      For DurableWriteOrderingSpyIndex, which implements the IIndexedCandidateRetrievalStrategy
      contract so both the local and PostgreSQL test assemblies can prove the same index-ordering
      invariant with one mechanism. Contracts only — no Lucene adapter reference, and still no test
      framework, so this stays a helper library per the note above.
    -->
    <ProjectReference Include="..\Linkuity.Matching\Linkuity.Matching.csproj" />
  </ItemGroup>

</Project>
